# Local Cloudflare Pages CLI cache — machine-local, may hold account state. Never committed.
.wrangler/

# Python bytecode from scripts/ (check_faq_jsonld.py). Regenerated on every run;
# left untracked it makes the tree dirty, which verify-push.sh correctly refuses.
__pycache__/

# Credentials -- never commit. `.env*.local` alone does NOT ignore `.env` itself,
# which is the file that held a live Supabase service_role key.
.env
.env.*
!.env.example

# Signing keys: App Store Connect .p8 keys must never be committed (hygiene D19, 2026-10-22)
*.p8
AuthKey_*
